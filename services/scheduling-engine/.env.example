# services/scheduling-engine — local dev / testing env only.
#
# In production this package runs as a Supabase Edge Function, where SUPABASE_URL
# and SUPABASE_SERVICE_ROLE_KEY are auto-injected into the Deno runtime by Supabase —
# you never set them there. This file is only for running/testing the engine locally
# outside the Edge Function environment (e.g. `deno test`, a local invocation harness).
# Copy to .env and fill with real values. Never commit .env.

# Project API URL (Dashboard > Settings > API). Used by a local test harness that
# needs to read tournament config / write Match[] the way the real Edge Function would.
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Service role key (Dashboard > Settings > API) — bypasses Row Level Security.
# Server-side / job-context only, matches what the Edge Function runtime injects.
# NEVER ship this to a client, never log it, never use it from services/back-office's
# client-side code.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
