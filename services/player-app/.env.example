# services/player-app — Flutter app (iOS + Android codebase, Android-first
# tester distribution). Copy to .env and fill with real values, or wire these
# into your Flutter env-loading approach of choice (e.g. --dart-define,
# flutter_dotenv). Never commit .env or a real dart-define file.
#
# This app has zero auth of any kind — there is no auth token/secret here by
# design. All values below are public-safe: Supabase anon key + RLS is the real
# access boundary, and AdMob app/unit IDs are meant to ship inside the app binary.

# Supabase project URL (Dashboard > Settings > API). Public-read API only —
# the Player App never calls an authenticated endpoint.
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Supabase anon/public key (Dashboard > Settings > API). Public-safe — RLS
# policies (services/supabase-infra) restrict this to published-only data.
SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# AdMob app IDs (AdMob console > App > App settings). Public-safe, shipped
# inside the app binary/manifest. Use Google's official test IDs during
# development, real IDs only in release builds.
ADMOB_APP_ID_ANDROID=ca-app-pub-3940256099942544~3347511713
ADMOB_APP_ID_IOS=ca-app-pub-3940256099942544~1458002511

# AdMob ad unit IDs (AdMob console > App > Ad units). Public-safe. iOS unit IDs
# are placeholders for the code-complete-but-undistributed iOS build (PRD:
# Android-first distribution, iOS ships code-complete this phase).
ADMOB_BANNER_UNIT_ID_ANDROID=ca-app-pub-3940256099942544/6300978111
ADMOB_BANNER_UNIT_ID_IOS=ca-app-pub-3940256099942544/2934735716
