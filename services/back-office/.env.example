# services/back-office — Nuxt 3 app (Nitro server routes colocated).
# Copy to .env and fill with real values. Never commit .env.
#
# In deployment, these are set as Vercel project environment variables
# (Vercel dashboard > Project > Settings > Environment Variables), scoped per
# environment (Development/Preview/Production). Locally, Nuxt reads .env directly.

# Supabase project URL (Dashboard > Settings > API). Public-safe — ships in the
# client bundle, used by the browser-side Supabase client.
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Supabase anon/public key (Dashboard > Settings > API). Public-safe by design —
# Row Level Security policies (services/supabase-infra) are the real access
# boundary, not secrecy of this key. Safe to ship in the client bundle.
SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase service role key (Dashboard > Settings > API) — bypasses Row Level
# Security entirely. Server-only (Nitro routes), used for tier-limit enforcement
# and any write that must not be subject to RLS. Must NEVER be exposed to the
# client bundle — only reference it from server-side Nitro route handlers
# (runtimeConfig, not runtimeConfig.public), never from client-side composables.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Session/cookie signing secret for Nuxt's server-side auth session handling
# (organizer email/password + magic-link via Supabase Auth). Generate a long
# random string per environment (e.g. `openssl rand -base64 32`); never reuse
# across Preview/Production. Server-only, never exposed to the client.
NUXT_SESSION_SECRET=changeme-generate-a-long-random-string
