# services/supabase-infra — local dev / CI env for running Supabase CLI commands
# (migrations, seed scripts, project config) against the real Supabase project.
# Copy to .env and fill with real values. Never commit .env.
#
# Project region is sa-east-1 (Sao Paulo) — set at project creation in the Supabase
# dashboard, not via an env var here. Noted for whoever provisions the project.

# Supabase project ref (the short id in the project's dashboard URL / Settings > General).
# Used by `supabase link` and `supabase db push` to target the right project.
SUPABASE_PROJECT_REF=xxxxxxxxxxxxxxxxxxxx

# Personal access token for the Supabase CLI (Dashboard > Account > Access Tokens).
# Lets the CLI authenticate to run migrations/link the project without a browser login.
# Treat as a secret: it has account-level API access, not just this one project.
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Postgres database password, set at project creation (Dashboard > Settings > Database).
# Required by `supabase db push`/`db remote commit` for direct Postgres connections.
SUPABASE_DB_PASSWORD=changeme
